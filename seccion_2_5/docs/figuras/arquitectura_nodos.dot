digraph arquitectura {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.65, ranksep=0.75, fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, color="#334155", margin="0.18,0.14"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#475569", arrowsize=0.8];
  entrada [label="Entrada contaminada x\nReferencia s: ensayo controlado", fillcolor="#f1f5f9"];
  n1 [label="NODO 1 · ESP32\nAdquisición + FFT y diagnóstico\nReloj e índices de muestra\nfs = 8000 Hz · H = 512", fillcolor="#dbeafe"];
  n2 [label="NODO 2 · ESP32\nFIR Kaiser de orden 36\n37 coeficientes · estado continuo", fillcolor="#dbeafe"];
  n3 [label="NODO 3 · ESP32\nFFT/IFFT + estimación causal\nN = 1024 · 50 % de solapamiento\nComparación por índices", fillcolor="#dcfce7"];
  { rank=same; n2; n3; }
  audio2 [label="Salida temporal\nDAC/PWM + reconstrucción", fillcolor="#f1f5f9"];
  audio3 [label="Salida espectral\nDAC/PWM + reconstrucción", fillcolor="#f1f5f9"];
  interfaz [label="Interfaz local\nMétodo, métricas válidas\nLatencia, pérdidas y saturación", fillcolor="#f1f5f9"];
  entrada -> n1 [label="ADC + antialias\no reproducción digital de prueba"];
  n1 -> n2 [label="INPUT x + DIAG\nUART 1 ↔ UART 1\n2196 B/avance máx.", dir=both];
  n1 -> n3 [label="INPUT_REF (x,s) + DIAG\nUART 2 ↔ UART 1\n4252 B/avance máx.", dir=both];
  n2 -> n3 [label="FIR_OUT y temporal\nUART 2 ↔ UART 2\n2094 B/avance máx.", dir=both, constraint=false];
  n2 -> audio2;
  n3 -> audio3;
  n3 -> interfaz;
  nota [shape=note, label="Tres enlaces independientes · GND común\nUART 921600 baud, 8N1 · control en sentido inverso\nCabecera + CRC-32 + COBS y delimitador\nReproducción propuesta: 256 ms antes de colas adicionales", fillcolor="#fff7ed", fontsize=10];
  interfaz -> nota [style=invis];
}
